# .env.example — Hiero environment variable reference
#
# LOCAL DEV: you need NONE of these. `pnpm dev` boots without any .env file;
# all variables below have safe fallbacks (see lib/build-version.ts and
# next.config.mjs). Copy what you need only when you intentionally want to
# override a default.
#
# CI: all variables are injected by the workflow; see .github/workflows/.
# PRODUCTION: per-channel env vars live in the Vercel project dashboards;
# see docs_canonical/DEPLOYMENT.md for the full runbook.

# ─── Build / version (CI-populated; local dev uses fallbacks) ───────────────

# Semantic version string for the current release.
# Default: read from package.json#version at build time.
# Optional for local dev.
NEXT_PUBLIC_APP_VERSION=

# Short git SHA identifying the build commit (e.g. "abc1234").
# Default: "dev"
# Optional for local dev.
NEXT_PUBLIC_BUILD_COMMIT=

# ISO-8601 timestamp of when this build was produced (e.g. "2026-06-11T00:00:00.000Z").
# Default: "1970-01-01T00:00:00.000Z" (epoch sentinel — visible in the navbar tooltip)
# Optional for local dev.
NEXT_PUBLIC_BUILD_TIME=

# Version of the @hiero/ui-icons package bundled in this build.
# Default: read from packages/hiero-ui-icons/package.json#version at build time.
# Optional for local dev.
NEXT_PUBLIC_HIERO_UI_ICONS_VERSION=

# ─── Channel / output mode ───────────────────────────────────────────────────

# Build channel: "public" (default) or "internal".
# "internal" enables maintenance toolbar actions and the full version triple
# in the navbar chip. Any unrecognised value silently falls back to "public"
# so a CI typo can't accidentally ship internal features.
# Default: "public"
# Optional for local dev.
NEXT_PUBLIC_BUILD_CHANNEL=

# Static export mode: set to "export" to produce a fully-static Next.js output
# (next.config.mjs sets `output: "export"` when this equals "export").
# Used by the Vercel static-export project; leave empty for server mode.
# Default: "" (server mode)
# Optional for local dev.
NEXT_OUTPUT_MODE=

# ─── Feature / debug flags ───────────────────────────────────────────────────

# Enable verbose Hiero runtime debug logging in the browser console.
# Default: unset (disabled)
# Optional for local dev.
NEXT_PUBLIC_HIERO_DEBUG=

# Enable verbose SVG-import debug logging in the browser console.
# Default: unset (disabled)
# Optional for local dev.
NEXT_PUBLIC_IMPORT_DEBUG=

# Enable Lottie preview in the editor (experimental).
# Default: unset (disabled)
# Optional for local dev.
NEXT_PUBLIC_LOTTIE_PREVIEW_ENABLED=

# Transition resolver version pin (e.g. "v2"). Used to A/B test resolver
# implementations without a full deploy. Leave unset to use the default.
# Default: unset
# Optional for local dev.
NEXT_PUBLIC_HIERO_RESOLVER_V=

# ─── Server-only secrets (NEVER commit real values) ─────────────────────────

# GitHub personal access token for the sync-service PR connector.
# Scope required: repo (read + write on target repositories).
# NEVER set in client-side or NEXT_PUBLIC_ variables.
GITHUB_SYNC_TOKEN=

# npm publish token for the npm-registry release target.
# NEVER set in client-side or NEXT_PUBLIC_ variables.
NPM_PUBLISH_TOKEN=

# Set to "true" to route npm publish calls through the proxy server.
# Default: unset (direct publish)
NPM_PUBLISH_PROXY_ENABLED=

# Comma-separated list of allowed npm registry URLs for the publish proxy.
# Example: "https://registry.npmjs.org,https://registry.company.com"
# Default: unset (all registries allowed if proxy is enabled)
NPM_PUBLISH_ALLOWED_REGISTRIES=
