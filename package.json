{
  "name": "hiero",
  "version": "0.1.0",
  "private": true,
  "description": "Icon design studio for stateful, animated SVG icons",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \".github/workflows/web-app-ci.yml\" \"scripts/check-coverage.ts\" \".prettierrc.json\" \"package.json\" \"pnpm-lock.yaml\"",
    "format:check": "prettier --check \".github/workflows/web-app-ci.yml\" \"scripts/check-coverage.ts\" \".prettierrc.json\" \"package.json\" \"pnpm-lock.yaml\"",
    "test": "bun run test:core && bun run test:dom",
    "test:core": "bun test tests/*.test.ts",
    "test:dom": "bun test tests/*.test.tsx tests/ds/*.test.tsx",
    "test:ci": "bun run test:core && bun run test:dom",
    "test:watch": "bun test --watch",
    "test:phase-a": "bun test tests/runtime-core.test.ts tests/runtime-dom.test.ts tests/runtime-dom-driver.test.ts tests/runtime-core-store.test.ts tests/export-runtime-json.test.ts tests/runtime-json-export.test.ts tests/runtime-react.test.tsx tests/runtime-react-phase4.test.tsx",
    "test:phase-a:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir coverage tests/runtime-core.test.ts tests/runtime-dom.test.ts tests/runtime-dom-driver.test.ts tests/runtime-core-store.test.ts tests/export-runtime-json.test.ts tests/runtime-json-export.test.ts tests/runtime-react.test.tsx tests/runtime-react-phase4.test.tsx tests/phase-8-morph.test.ts tests/phase-78-coverage-boost.test.ts tests/morph.test.ts tests/phase-c-editor-animation.test.ts tests/phase-d-react-api.test.tsx",
    "check:coverage": "bun scripts/check-coverage.ts --coverage-dir coverage --include lib/export/export-runtime-json.ts,lib/runtime-core/,lib/runtime-dom/,lib/runtime-react/ --min-lines 60 --min-functions 0",
    "test:sync": "bun test tests/sync-source.test.ts tests/sync-service.test.ts tests/sync-conflicts.test.ts tests/sync-analytics.test.ts tests/sync-ui.test.ts",
    "test:export": "bun test tests/compile-pipeline.test.ts tests/compiled-icon-export.test.ts tests/export-react.test.ts tests/export-runtime-json.test.ts tests/export-svg-package.test.ts tests/react-codegen.test.ts tests/runtime-json-export.test.ts",
    "test:import": "bun test tests/adapter-sdk.test.ts tests/lucide-adapter.test.ts tests/normalized-ir.test.ts tests/raw-svg-adapter.test.ts tests/svg-normalizer.test.ts tests/svg-sanitizer.test.ts tests/svg-import.test.ts tests/svg-import-flow.test.ts tests/import-svg.test.ts",
    "type-check": "tsc --noEmit",
    "compile:icons": "bun scripts/compile-icons.ts",
    "compile:from-source": "bun scripts/compile-from-source.ts",
    "build:icons:package": "bun scripts/build-icons-package.ts",
    "validate:icons:package": "bun scripts/validate-icons-package.ts",
    "validate:source-export": "bun scripts/validate-source-export.ts --source .",
    "release:icons:dry-run": "bun scripts/release-icons-dry-run.ts",
    "check:runtime-size": "bun scripts/check-runtime-size.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --stats-json",
    "build-storybook": "storybook build --stats-json",
    "storybook:test": "vitest --project=storybook"
  },
  "dependencies": {
    "@fontsource/work-sans": "^5.2.8",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^3.9.1",
    "@material-symbols/svg-400": "^0.42.3",
    "@phosphor-icons/core": "^2.1.1",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@vercel/analytics": "1.6.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "color": "^5.0.3",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.6.0",
    "geist": "^1.7.0",
    "input-otp": "1.4.2",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.0.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "9.13.2",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.54.1",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.9.0",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-themes": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/nextjs-vite": "^10.3.5",
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.10",
    "@types/color": "^4.2.1",
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/browser": "^3.2.4",
    "chromatic": "^16.3.0",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.9.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5",
    "prettier": "^3.5.3",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^3.2.4"
  }
}
