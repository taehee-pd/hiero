{
  "$description": "Hiero component tokens — DTCG format (W3C 2025.10). The redesign surface for every DS component. Edit values here, then run `pnpm tokens:build` to regenerate app/_generated/component-tokens.css. To add a new theme, create tokens/themes/<id>.tokens.json with the same structure.",

  "btn": {
    "$description": "IconButton component tokens. Trimmed to only what call sites actually use — the radius and visual-variant axes were dropped because no caller exercised them. Add tokens here only when you have a real second consumer.",
    "icon": {
      "fg": {
        "default": { "$value": "{semantic.foreground}", "$type": "color" }
      },
      "bg": {
        "ghost":       { "$value": "transparent",         "$type": "color" },
        "ghost-hover": { "$value": "{semantic.accent}",   "$type": "color" }
      },
      "fg-ghost-hover": { "$value": "{semantic.accent-foreground}", "$type": "color" },
      "radius": {
        "toolbar": { "$value": "0.5rem", "$type": "dimension" }
      },
      "transition": { "$value": "all 120ms ease",  "$type": "string" },
      "focus-ring": { "$value": "{semantic.ring}", "$type": "color"  }
    }
  },

  "tag": {
    "$description": "Classification chip tokens. Mirrors Figma component-collection variables in Hiero — Design System (tag/*).",
    "radius":         { "$value": "0.25rem",                "$type": "dimension" },
    "padding-x":      { "$value": "0.25rem",                "$type": "dimension" },
    "padding-y":      { "$value": "0.0625rem",              "$type": "dimension" },
    "font-size":      { "$value": "{semantic.text-caption}", "$type": "dimension" },
    "font-weight":    { "$value": 500,                       "$type": "fontWeight" },
    "line-height":    { "$value": "0.875rem",                "$type": "dimension" },
    "letter-spacing": { "$value": "0",                       "$type": "string" },
    "bg": {
      "muted":   { "$value": "{semantic.muted}",                  "$type": "color" },
      "info":    { "$value": "{semantic.background-highlight}",   "$type": "color" },
      "success": { "$value": "{semantic.background-success}",     "$type": "color" },
      "warning": { "$value": "{semantic.background-warning}",     "$type": "color" },
      "danger":  { "$value": "{semantic.background-danger}",      "$type": "color" },
      "outline": { "$value": "transparent",                        "$type": "color" }
    },
    "fg": {
      "muted":   { "$value": "{semantic.muted-foreground}",        "$type": "color" },
      "info":    { "$value": "{semantic.foreground-highlight}",    "$type": "color" },
      "success": { "$value": "{semantic.foreground-success}",      "$type": "color" },
      "warning": { "$value": "{semantic.foreground-warning}",      "$type": "color" },
      "danger":  { "$value": "{semantic.foreground-danger}",       "$type": "color" },
      "outline": { "$value": "{semantic.foreground-secondary}",    "$type": "color" }
    },
    "border": {
      "muted":   { "$value": "transparent",       "$type": "color" },
      "info":    { "$value": "transparent",       "$type": "color" },
      "success": { "$value": "transparent",       "$type": "color" },
      "warning": { "$value": "transparent",       "$type": "color" },
      "danger":  { "$value": "transparent",       "$type": "color" },
      "outline": { "$value": "{semantic.border}", "$type": "color" }
    }
  },

  "badge": {
    "$description": "StatusBadge tokens — pill shape for state indicators.",
    "radius":      { "$value": "9999px",                     "$type": "dimension" },
    "padding-x":   { "$value": "0.5rem",                     "$type": "dimension" },
    "padding-y":   { "$value": "0.125rem",                   "$type": "dimension" },
    "font-size":   { "$value": "{semantic.text-caption}",    "$type": "dimension" },
    "font-weight": { "$value": 500,                          "$type": "fontWeight" },
    "gap":         { "$value": "0.375rem",                   "$type": "dimension" },
    "bg": {
      "saved":     { "$value": "{semantic.background-success}",   "$type": "color" },
      "unsaved":   { "$value": "{semantic.background-warning}",   "$type": "color" },
      "connected": { "$value": "{semantic.background-highlight}", "$type": "color" },
      "error":     { "$value": "{semantic.background-danger}",    "$type": "color" },
      "neutral":   { "$value": "{semantic.muted}",                "$type": "color" }
    },
    "fg": {
      "saved":     { "$value": "{semantic.foreground-success}",   "$type": "color" },
      "unsaved":   { "$value": "{semantic.foreground-warning}",   "$type": "color" },
      "connected": { "$value": "{semantic.foreground-highlight}", "$type": "color" },
      "error":     { "$value": "{semantic.foreground-danger}",    "$type": "color" },
      "neutral":   { "$value": "{semantic.muted-foreground}",     "$type": "color" }
    }
  },

  "field": {
    "$description": "ColorField + numeric input tokens.",
    "radius":         { "$value": "0.5rem",                       "$type": "dimension" },
    "height":         { "$value": "{semantic.field-height-md}",   "$type": "dimension" },
    "padding-x":      { "$value": "0.5rem",                       "$type": "dimension" },
    "bg":             { "$value": "{semantic.background}",        "$type": "color" },
    "fg":             { "$value": "{semantic.foreground}",        "$type": "color" },
    "border":         { "$value": "{semantic.border}",            "$type": "color" },
    "border-focus":   { "$value": "{semantic.ring}",              "$type": "color" },
    "swatch-size":    { "$value": "18px",                         "$type": "dimension" },
    "swatch-radius":  { "$value": "0.25rem",                      "$type": "dimension" },
    "swatch-border":  { "$value": "{semantic.border}",            "$type": "color" }
  },

  "kbd": {
    "$description": "Kbd glyph tokens (used by KbdHint). Mirrors Figma component-collection variables in Hiero — Design System (kbd/*).",
    "bg":             { "$value": "{semantic.background-secondary}", "$type": "color" },
    "fg":             { "$value": "{semantic.foreground-secondary}", "$type": "color" },
    "border":         { "$value": "{semantic.border}",               "$type": "color" },
    "border-width":   { "$value": "0.5px",                            "$type": "dimension" },
    "radius":         { "$value": "0.25rem",                          "$type": "dimension" },
    "padding-x":      { "$value": "0.125rem",                         "$type": "dimension" },
    "padding-y":      { "$value": "0",                                "$type": "dimension" },
    "font-size":      { "$value": "0.5625rem",                        "$type": "dimension" },
    "font-family":    { "$value": "{semantic.font-mono}",             "$type": "fontFamily" },
    "font-weight":    { "$value": 500,                                "$type": "fontWeight" },
    "line-height":    { "$value": "0.6875rem",                        "$type": "dimension" },
    "letter-spacing": { "$value": "0",                                "$type": "dimension" },
    "min-width":      { "$value": "0.875rem",                         "$type": "dimension" },
    "min-height":     { "$value": "0.875rem",                         "$type": "dimension" }
  },

  "kbd-hint": {
    "$description": "KbdHint group tokens — spacing between Kbd glyphs in a shortcut combo. Mirrors Figma KbdHint component-set itemSpacing.",
    "gap": { "$value": "0.0625rem", "$type": "dimension" }
  },

  "tooltip": {
    "$description": "Tooltip surface tokens. Mirrors Figma Tooltip component-set (HasKbd=false/true). No arrow/tail — Figma design has none.",
    "bg":             { "$value": "{semantic.foreground}",     "$type": "color" },
    "fg":             { "$value": "{semantic.background}",     "$type": "color" },
    "radius":         { "$value": "0.4375rem",                  "$type": "dimension" },
    "padding-x":      { "$value": "0.375rem",                   "$type": "dimension" },
    "padding-y":      { "$value": "0.1875rem",                  "$type": "dimension" },
    "gap":            { "$value": "0.25rem",                    "$type": "dimension" },
    "font-size":      { "$value": "{semantic.text-caption}",    "$type": "dimension" },
    "font-weight":    { "$value": 500,                          "$type": "fontWeight" },
    "line-height":    { "$value": "0.875rem",                   "$type": "dimension" },
    "letter-spacing": { "$value": "0",                          "$type": "string" }
  },

  "shortcut-row": {
    "$description": "ShortcutRow tokens — labeled keyboard shortcut row.",
    "bg":          { "$value": "color-mix(in srgb, {semantic.background} 60%, transparent)", "$type": "color" },
    "fg":          { "$value": "{semantic.foreground}",                                       "$type": "color" },
    "border":      { "$value": "color-mix(in srgb, {semantic.border} 70%, transparent)",      "$type": "color" },
    "radius":      { "$value": "0.5rem",                                                       "$type": "dimension" },
    "padding-x":   { "$value": "0.75rem",                                                      "$type": "dimension" },
    "padding-y":   { "$value": "0.375rem",                                                     "$type": "dimension" },
    "shadow":      { "$value": "{semantic.shadow-outline}",                                    "$type": "shadow" },
    "gap":         { "$value": "1rem",                                                         "$type": "dimension" },
    "font-size":   { "$value": "{semantic.text-body}",                                         "$type": "dimension" }
  }
}
